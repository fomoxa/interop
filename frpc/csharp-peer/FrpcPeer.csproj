<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>frpc-csharp-peer</AssemblyName>
    <RootNamespace>Fomoxa.Rpc.Interop</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fomoxa.Rpc" Version="0.1.0" />
    <PackageReference Include="Fomoxa.Attributes" Version="0.1.0" />
    <EmbeddedResource Include=".fomoxa/schema.json" LogicalName="schema.json" />
    <None Remove=".fomoxa/**" />
  </ItemGroup>

</Project>
